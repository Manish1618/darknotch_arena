# Copy to .env and fill in every value. Generate secrets with: openssl rand -hex 32
DOMAIN=ctf.example.org
SITE_NAME=Darkn0tch Arena

# --- secrets (generate once, never change) ---------------------------------
DB_PASSWORD=change-me-to-a-long-random-string
REDIS_PASSWORD=change-me-to-a-long-random-string
# Keys the stored flag hashes. Changing it makes every stored flag stop matching.
FLAG_PEPPER=change-me-openssl-rand-hex-32
# Encrypts 2FA secrets and keys recovery-code and email-code hashes.
# Changing it breaks everyone's 2FA and recovery codes.
SECRET_KEY=change-me-openssl-rand-hex-32

# --- scale ------------------------------------------------------------------
# Backend containers: about one per CPU core. Frontend: 2 is plenty.
API_REPLICAS=4
WEB_REPLICAS=2
# Postgres connections per backend container. Keep
# API_REPLICAS x (DB_POOL_SIZE + DB_POOL_OVERFLOW) under 200.
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=10

# --- email (required: sign-up and password reset send 6-digit codes) --------
# Any SMTP provider works: Amazon SES, Brevo, Postmark, Mailgun, Gmail (app password)...
# SMTP_HOST=log tries the site before mail is set up: codes are written to
# `docker compose logs api` instead of being sent, so only you can sign up.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Darkn0tch Arena <no-reply@ctf.example.org>
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls

# --- "Sign in with ..." (leave a pair empty to hide that button) -------------
# Google sign-in. Redirect URI to register: https://DOMAIN/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- policy -----------------------------------------------------------------
# "required" (default): organisers and site admins must turn on 2FA first.
ORGANISER_MFA=required
